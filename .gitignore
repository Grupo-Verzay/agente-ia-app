# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev-server.log
dev-server.err.log

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma migrations should be versioned with schema changes

# Claude Code local config
.claude/

# Carpetas de referencia externa (no pertenecen al proyecto)
/forms/

# Compilado temporal del banco de pruebas (ver lib/__tests__/*.test.mjs)
lib/__tests__/.compilado/
# Y el de los bancos que van contra Postgres: se emiten aqui dentro para que
# `@prisma/client` resuelva desde el repo.
.banco/

# El segmentador de fondo: lo copia `npm run prebuild` desde node_modules.
# Son 6 MB de wasm que no tienen por que vivir en el historial de git.
/public/segmentacion/
lib/__tests__/.antes/
